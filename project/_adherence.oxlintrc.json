{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/finance/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/mobile-app/**",
              "ui_kits/web-dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Public Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Public Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AllocationSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|key|ref|className|style|children)$/]",
        "message": "<AllocationSegment> doesn't accept that prop. Declared props: label, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetTypeBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|size|style|key|ref|className|style|children)$/]",
        "message": "<AssetTypeBadge> doesn't accept that prop. Declared props: type, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetTypeBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<AssetTypeBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|variant|size|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, variant, size, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|positive|negative|amber|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'positive' | 'negative' | 'amber' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|outline)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|disabled|loading|leadingIcon|trailingIcon|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, disabled, loading, leadingIcon, trailingIcon, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|brandSoft)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'brandSoft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pad|interactive|selected|as|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, pad, interactive, selected, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> pad must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangeValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|percent|format|showCaret|showSign|size|weight|align|currency|style|key|ref|className|style|children)$/]",
        "message": "<ChangeValue> doesn't accept that prop. Declared props: value, percent, format, showCaret, showSign, size, weight, align, currency, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangeValue'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:percent|currency|number)$/]",
        "message": "<ChangeValue> format must be one of 'percent' | 'currency' | 'number'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangeValue'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<ChangeValue> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangeValue'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|medium|semibold|bold)$/]",
        "message": "<ChangeValue> weight must be one of 'regular' | 'medium' | 'semibold' | 'bold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChangeValue'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<ChangeValue> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompanyMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:ticker|name|src|size|radius|style|key|ref|className|style|children)$/]",
        "message": "<CompanyMark> doesn't accept that prop. Declared props: ticker, name, src, size, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HalalBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<HalalBadge> doesn't accept that prop. Declared props: status, size, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HalalBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:compliant|review|non-compliant|unrated)$/]",
        "message": "<HalalBadge> status must be one of 'compliant' | 'review' | 'non-compliant' | 'unrated'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HalalBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<HalalBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|variant|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, variant, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|onChange|placeholder|type|size|leadingIcon|trailingIcon|prefix|suffix|disabled|invalid|mono|block|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, defaultValue, onChange, placeholder, type, size, leadingIcon, trailingIcon, prefix, suffix, disabled, invalid, mono, block, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|sub|hint|align|emphasis|style|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: label, value, sub, hint, align, emphasis, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<MetricTile> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|width|height|color|fill|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, width, height, color, fill, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|size|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Switch> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:verdict|size|style|key|ref|className|style|children)$/]",
        "message": "<VerdictPill> doesn't accept that prop. Declared props: verdict, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictPill'] > JSXAttribute[name.name='verdict'] > Literal[value!=/^(?:buy|watch|avoid)$/]",
        "message": "<VerdictPill> verdict must be one of 'buy' | 'watch' | 'avoid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictPill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<VerdictPill> size must be one of 'sm' | 'md'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
