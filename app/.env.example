# Grad Fund — environment variables
#
# ─── IBKR (primary data source + trading) ────────────────────────────────────
#
# 1. Install the IBKR Client Portal Gateway:
#    https://www.interactivebrokers.com/en/trading/ib-api.php
#
# 2. Start it and log in at https://localhost:5000
#
# 3. Run both servers: npm run dev:full
#    This starts the Express backend (port 3001) AND the Vite dev server (port 5173).
#    The Vite server proxies /api/* to the Express backend automatically.
#
IBKR_HOST=localhost
IBKR_PORT=5000
SERVER_PORT=3001

# ─── Alpha Vantage (fallback if IBKR is unavailable) ─────────────────────────
#
# Get a free key at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day.
#
VITE_ALPHA_VANTAGE_KEY=your_key_here
